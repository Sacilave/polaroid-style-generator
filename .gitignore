# ==========================================
# 1. 本地归档与敏感备份（高优先级拦截）
# ==========================================
_archive/
archive/
*.zip
*.tar.gz
*.7z

# ==========================================
# 2. 运行时媒体与照片资产（防泄漏）
# ==========================================
images/input/*
images/output/*
images/converted/*
!images/input/.gitkeep
!images/output/.gitkeep
!images/converted/.gitkeep

# 文档固定演示用图白名单（README 必需，其余排除）
READMEIMG/*
!READMEIMG/*.jpg

# ==========================================
# 3. Python 运行与构建缓存
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.env
.venv
venv/
ENV/

# ==========================================
# 4. 编辑器与系统临时文件
# ==========================================
.vscode/
.idea/
*.swp
*.DS_Store
Thumbs.db
